<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <!--
    Phantom MSI descriptor.

    v1.0 scope is Layer-2 (user-mode registry spoofing) only. The
    Layer-1 kernel driver is deferred (WHQL attestation is a Phase-2
    project) so this file does NOT install a driver, does NOT copy
    phantom.sys/phantom.inf, and does NOT invoke pnputil. The prior
    stub is preserved in git history — grep for DriverFeature there
    when Layer 1 lands.

    UpgradeCode stays constant across versions so a newer MSI
    replaces an older one via MajorUpgrade. NEVER change it.
  -->

  <?define ProductVersion = "1.1.0" ?>

  <Product Id="*"
           Name="Phantom"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="Phantom"
           UpgradeCode="{7B2E4F9A-3D1C-4E8B-A5F6-2C9D0E1F3A4B}">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             InstallPrivileges="elevated"
             Description="Hardware identity privacy tool"
             Platform="x64" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Phantom is already installed."
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />

    <!-- Add/Remove Programs entry metadata. Points at the GitHub repo,
         the one contact surface that definitely exists. ARPPRODUCTICON
         is deferred until a product icon asset lands with the brand pass.
         ARPNOREPAIR keeps the entry to a single Uninstall action (there are no
         repair or feature-modify flows in v1). ARPNOMODIFY is set by the
         WixUI_Minimal extension itself, so defining it here too is a
         duplicate-symbol error at link time; leave it to the extension. -->
    <Property Id="ARPHELPLINK" Value="https://github.com/HarperZ9/phantom" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/HarperZ9/phantom" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/HarperZ9/phantom/releases" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- ================================================================ -->
    <!-- Feature: one feature only for v1 (no optional driver yet).       -->
    <!-- ================================================================ -->

    <Feature Id="CoreFeature" Title="Phantom Core" Level="1"
             Description="Service, tray app, and CLI"
             Absent="disallow" AllowAdvertise="no">
      <ComponentRef Id="PhantomCli" />
      <ComponentRef Id="PhantomSvc" />
      <ComponentRef Id="PhantomTray" />
      <ComponentRef Id="TrayAutostart" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="PhantomDataStore" />
    </Feature>

    <!-- ================================================================ -->
    <!-- Directory layout                                                 -->
    <!-- ================================================================ -->

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Phantom" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="PhantomMenuFolder" Name="Phantom" />
      </Directory>
      <!--
        Machine-wide state store: %ProgramData%\Phantom. Shared by the
        elevated-user CLI (which writes the registry backup on apply) and
        the LocalSystem service (which reads it on pre-uninstall cleanup
        to revert). It is granted to Users so non-elevated commands like
        `phantom generate` and `phantom license activate` can write here.
      -->
      <Directory Id="CommonAppDataFolder">
        <Directory Id="PhantomDataFolder" Name="Phantom" />
      </Directory>
    </Directory>

    <!-- ================================================================ -->
    <!-- Components: Binaries                                             -->
    <!-- ================================================================ -->

    <DirectoryRef Id="INSTALLFOLDER">

      <Component Id="PhantomCli" Guid="*" Win64="yes">
        <File Id="PhantomCliExe"
              Source="$(var.BuildDir)\phantom-cli.exe"
              Name="phantom.exe"
              KeyPath="yes" />
      </Component>

      <!--
        phantom-svc is BOTH a plain-file installed binary AND the
        target of the ServiceInstall entry. Keeping the ServiceInstall
        inside the same component that owns the file guarantees the
        Windows Installer sequences the file copy before the service
        registration, and the file removal after the service
        deregistration, without any manual sequencing.
      -->
      <Component Id="PhantomSvc" Guid="*" Win64="yes">
        <File Id="PhantomSvcExe"
              Source="$(var.BuildDir)\phantom-svc.exe"
              KeyPath="yes" />
        <ServiceInstall Id="PhantomSvcInstall"
                        Type="ownProcess"
                        Name="PhantomService"
                        DisplayName="Phantom Privacy Service"
                        Description="Background orchestrator for hardware identity privacy. Manages profile application across the registry layer."
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal" />
        <ServiceControl Id="PhantomSvcControl"
                        Name="PhantomService"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <Component Id="PhantomTray" Guid="*" Win64="yes">
        <File Id="PhantomTrayExe"
              Source="$(var.BuildDir)\phantom-tray.exe"
              KeyPath="yes" />
      </Component>

    </DirectoryRef>

    <!-- ================================================================ -->
    <!-- Components: Tray auto-start at user login                        -->
    <!-- ================================================================ -->

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="TrayAutostart" Guid="*" Win64="yes">
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                       Name="PhantomTray"
                       Type="string"
                       Value="[INSTALLFOLDER]phantom-tray.exe"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- ================================================================ -->
    <!-- Components: Start Menu shortcut                                  -->
    <!-- ================================================================ -->

    <!-- ================================================================ -->
    <!-- Component: machine-wide data store with a Users-writable ACL     -->
    <!-- ================================================================ -->

    <!-- WIX_ACCOUNT_USERS resolves the built-in Users group by its
         well-known SID at install time, so the ACL below is correct on
         localized Windows (where the group is not named "Users"). -->
    <PropertyRef Id="WIX_ACCOUNT_USERS" />

    <DirectoryRef Id="PhantomDataFolder">
      <Component Id="PhantomDataStore" Guid="*" Win64="yes">
        <CreateFolder>
          <!-- Append (not replace) an ACE so SYSTEM/Administrators access
               inherited from %ProgramData% is preserved. Grants Users the
               ability to create/read/write files here, so non-elevated
               commands (phantom generate, phantom license activate) work. -->
          <util:PermissionEx User="[WIX_ACCOUNT_USERS]" GenericAll="yes" />
        </CreateFolder>
        <RemoveFolder Id="RemovePhantomDataFolder" On="uninstall" />
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Phantom"
                       Name="DataStore"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="PhantomMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*" Win64="yes">
        <Shortcut Id="PhantomTrayShortcut"
                  Name="Phantom"
                  Description="Hardware identity privacy tray"
                  Target="[INSTALLFOLDER]phantom-tray.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemovePhantomMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="SOFTWARE\Phantom"
                       Name="StartMenuInstalled"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- ================================================================ -->
    <!-- Custom Action: pre-uninstall cleanup                             -->
    <!--                                                                  -->
    <!--   Runs phantom-svc.exe with the cleanup flag. It reverts every  -->
    <!--   active identity layer via the IPC socket (or, if the service  -->
    <!--   is already stopped, a direct in-process revert), removes the  -->
    <!--   tray Run value, and clears the sealed config file.            -->
    <!--                                                                  -->
    <!--   Return=ignore so a cleanup failure (service already gone or   -->
    <!--   config already missing) does not stop the uninstall.          -->
    <!-- ================================================================ -->

    <SetProperty Id="CleanupAction"
                 Value="&quot;[INSTALLFOLDER]phantom-svc.exe&quot; --cleanup"
                 Before="CleanupAction"
                 Sequence="execute" />
    <CustomAction Id="CleanupAction"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- On uninstall (and only on uninstall), revert identity layers
           BEFORE the service is stopped so the running service can
           still receive the IPC request. -->
      <Custom Action="CleanupAction" Before="StopServices">
        REMOVE~="ALL"
      </Custom>
    </InstallExecuteSequence>

    <!-- ================================================================ -->
    <!-- UI: minimal dialog set + EULA                                    -->
    <!-- ================================================================ -->

    <UIRef Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="eula.rtf" />

  </Product>
</Wix>
